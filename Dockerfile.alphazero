# AlphaZero Synchronized Training Container
#
# Bundles both the Rust actor and Python trainer for synchronized training.
# Each iteration: allocate an exact replay scope -> run bounded collectors
# pinned to one source checkpoint -> seal -> train -> evaluate -> commit
#
# Usage:
#   docker build -f Dockerfile.alphazero -t cartridge-alphazero .
#   docker run -v ./data:/app/data cartridge-alphazero
#
# For K8s backends (S3 model storage):
#   docker build -f Dockerfile.alphazero --build-arg CARGO_FEATURES="s3" .
#
# Or via docker-compose:
#   docker compose up alphazero

# ============================================
# Stage 1: Build Rust Actor
# ============================================
# Using Ubuntu 24.04 for glibc >= 2.38 (required by onnxruntime prebuilt binaries)
FROM ubuntu:24.04 AS rust-builder

# PostgreSQL is built-in. Optional feature: s3 (S3 model storage)
ARG CARGO_FEATURES=""

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Copy and build actor with optional features
COPY config.defaults.toml ./
COPY engine/ ./engine/
COPY actor/ ./actor/
COPY sql/ ./sql/

WORKDIR /app/actor
RUN if [ -z "$CARGO_FEATURES" ]; then \
        cargo build --release; \
    else \
        cargo build --release --features "$CARGO_FEATURES"; \
    fi

# The evaluation binary. The trainer shells out to it for every evaluation, so
# without it the cartridge's `loop` command cannot gate promotions. Its
# features are actor-independent (ONNX is always on), hence no CARGO_FEATURES.
WORKDIR /app/engine
RUN cargo build --release -p evaluator

# ============================================
# Stage 2: Python Runtime with Actor Binary
# ============================================
# Using Ubuntu 24.04 for glibc >= 2.38 (required by onnxruntime prebuilt binaries)
FROM ubuntu:24.04

# Install Python and runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    libssl3 \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*
# git is required: the trainer declares `crucible` as a pinned git dependency.

# Pin the runtime identity so Kubernetes can grant the mounted data volume to
# exactly the same non-root user used by the image.
RUN useradd --create-home --uid 1000 --user-group cartridge

# Create symlinks for python/pip commands
RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Copy actor binary from rust builder
COPY --from=rust-builder /app/actor/target/release/actor /app/actor

# Copy the evaluation binary (see ENV CARTRIDGE_EVAL_BINARY below)
COPY --from=rust-builder /app/engine/target/release/cartridge-eval /app/cartridge-eval

# Copy config defaults (used by Python trainer)
COPY config.defaults.toml ./

# Copy trainer source and install
COPY trainer/pyproject.toml trainer/README.md ./trainer/
COPY trainer/src/ ./trainer/src/

# Install CPU-only PyTorch (avoids ~700MB CUDA download)
RUN pip install --no-cache-dir --break-system-packages torch --index-url https://download.pytorch.org/whl/cpu

# Install trainer package (pulls in the pinned crucible orchestration core)
RUN pip install --no-cache-dir --break-system-packages ./trainer

# Smoke-check the *installed* package. Nothing else does: the test suite puts
# trainer/src on sys.path directly, and CI's docker-build job never runs the
# image. Without this, a packaging regression (a missing package-data entry, or
# a dropped crucible dependency) passes every CI job and fails only in
# production, at container start.
RUN python -c "import crucible; from trainer.algorithms.registry import get_algorithm; from trainer.environment_catalog import get_environment; algorithm = get_algorithm('alphazero_board_v1'); algorithm.compatibility(get_environment('tictactoe')).require_compatible()"

# Set before the smoke check below so it resolves the binary exactly the way
# the running container will, rather than via the fallback candidate paths.
ENV CARTRIDGE_EVAL_BINARY="/app/cartridge-eval"

# Smoke-check the evaluation path end to end: locating the binary and playing a
# game through the real engine. A missing or unrunnable binary would otherwise
# surface only when the first iteration tried to gate a promotion.
RUN python -c "\
from trainer.evaluator import evaluate, find_eval_binary; \
from trainer.players import RandomPlayer; \
print('eval binary:', find_eval_binary()); \
r = evaluate(player1=RandomPlayer(), player2=RandomPlayer(), algorithm_id='alphazero_board_v1', env_id='tictactoe', num_games=2); \
assert r.games_played == 2, r"

# Create the root under which the trainer creates immutable runtime profiles:
# profiles/{algorithm_id}/{env_id}/v{env_contract_version}.
RUN mkdir -p /app/data && chown -R cartridge:cartridge /app/data

# ============================================
# Environment Configuration
# ============================================
# Actor binary location (used by orchestrator)
ENV ACTOR_BINARY="/app/actor"
ENV CARTRIDGE_COMMON_DATA_DIR="/app/data"

# Training, evaluation, environment, and algorithm defaults come exclusively
# from config.toml and CARTRIDGE_* overrides.

# Run as non-root user
USER cartridge

# Keep the module as the stable image entrypoint and put the canonical
# cartridge selection before the command. Supplying arguments to `docker run`
# replaces CMD, which also makes one-off commands use the same CLI surface.
ENTRYPOINT ["python", "-m", "trainer"]
CMD ["--algorithm", "alphazero_board_v1", "loop"]
